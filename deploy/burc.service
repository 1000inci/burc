# systemd servis dosyası — /etc/systemd/system/burc.service
# Kurulum:
#   sudo cp deploy/burc.service /etc/systemd/system/burc.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now burc
#   sudo systemctl status burc
#
# Not: WorkingDirectory ve venv yolunu sunucudaki gerçek konuma göre düzenleyin.

[Unit]
Description=Burc Uygulamasi (Flask + gunicorn)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/burc
Environment="PATH=/opt/burc/venv/bin"
ExecStart=/opt/burc/venv/bin/gunicorn --workers 3 --bind 127.0.0.1:8050 wsgi:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
